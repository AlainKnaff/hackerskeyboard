<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.WRITE_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
      <intent>
	<action android:name="com.menny.android.anysoftkeyboard.KEYBOARD" />
      </intent>
      <intent>
	<action android:name="org.pocketworkstation.DICT" />
      </intent>
    </queries>

    <application android:label="@string/english_ime_name"
            android:allowBackup="true"
            android:backupAgent="LatinIMEBackupAgent"
            android:restoreAnyVersion="true"
            android:killAfterRestore="false"
            android:icon="@drawable/icon"
	    android:supportsRtl="true"
	    >

        <service android:name="org.pocketworkstation.pckeyboard.LatinIME"
                 android:label="@string/english_ime_name"
                 android:permission="android.permission.BIND_INPUT_METHOD"
                 android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <activity android:name="org.pocketworkstation.pckeyboard.Main"
		  android:label="Son of Hacker's Keyboard"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
	    android:name="org.pocketworkstation.pckeyboard.LatinIMESettings"
	    android:label="@string/english_ime_settings"
            android:exported="false">
        </activity>

        <activity
	    android:name="org.pocketworkstation.pckeyboard.InputLanguageSelection"
            android:label="@string/language_selection_title"
            android:exported="false">
        </activity>

        <activity
	    android:name="org.pocketworkstation.pckeyboard.PrefScreenActions"
            android:label="@string/pref_screen_actions_title"
            android:exported="false">
        </activity>

        <activity android:name="org.pocketworkstation.pckeyboard.PrefScreenView"
                  android:label="@string/pref_screen_actions_title"
                  android:exported="false">
        </activity>

        <activity
	    android:name="org.pocketworkstation.pckeyboard.PrefScreenFeedback"
            android:label="@string/pref_screen_feedback_title"
            android:exported="false">
        </activity>

        <activity
	    android:name="org.pocketworkstation.pckeyboard.ImportSettingsActivity"
	    android:theme="@style/TransparentActivityTheme"
            android:exported="false">
        </activity>

        <activity
	    android:name="org.pocketworkstation.pckeyboard.ExportSettingsActivity"
	    android:theme="@style/TransparentActivityTheme"
            android:exported="false">
        </activity>
    </application>
</manifest>
